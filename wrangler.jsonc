{
	"compatibility_date": "2026-05-24",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "maybesoft",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "maybesoft-db",
			"database_id": "8c50e047-d1cb-4ee4-b816-86c559873d9d"
		}
	]
}