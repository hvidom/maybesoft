---

import BaseHead from "@/components/layouts/base-head.astro";
import TailwindIndicator from "@/components/layouts/tailwind-indicator.astro";

import { cn } from "@/lib/utils";

type Props = {
  title: string;
  description?: string;
  mainClass?: string;
};

const { title, description, mainClass } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body
    class="min-h-screen bg-background text-foreground relative overflow-x-hidden"
  >
    <TailwindIndicator />

    <div class="relative z-10">
      <main class={cn(mainClass)}>
        <slot />
      </main>
    </div>
  </body>
</html>
