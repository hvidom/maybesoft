---
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";

// Check if user is already authenticated
const adminToken = Astro.cookies.get("admin_github_token")?.value;
if (adminToken) {
  return Astro.redirect("/admin");
}
---

<Layout
  title="Admin Portal Sign In"
  description="Secure owner administration access gate"
>
  <div
    class="relative min-h-screen flex items-center justify-center bg-slate-950 overflow-hidden px-4"
  >
    <!-- Animated background grids & glow circles -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a_1px,transparent_1px),linear-gradient(to_bottom,#0f172a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-60"
    ></div>

    <div
      class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl animate-pulse"
    ></div>
    <div
      class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-600/20 rounded-full blur-3xl animate-pulse"
      style="animation-delay: 2s;"
    ></div>

    <div class="relative z-10 w-full max-w-md">
      <Card
        class="border-slate-800 bg-slate-900/60 backdrop-blur-xl shadow-2xl overflow-hidden ring-1 ring-slate-700/50"
      >
        <!-- Top accent gradient line -->
        <div
          class="h-1.5 w-full bg-gradient-to-r from-purple-500 via-violet-600 to-cyan-500"
        ></div>

        <CardHeader class="space-y-3 pt-8 text-center">
          <div
            class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-purple-500 to-cyan-500 shadow-lg shadow-purple-500/20"
          >
            <svg
              class="h-8 w-8 text-white"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
              />
            </svg>
          </div>
          <CardTitle
            class="text-3xl font-extrabold tracking-tight text-white bg-clip-text"
          >
            Admin Portal
          </CardTitle>
          <CardDescription class="text-slate-400 text-sm">
            Authenticate to manage website codebase content
          </CardDescription>
        </CardHeader>

        <CardContent class="space-y-6 pb-8 px-8">
          <p class="text-center text-xs text-slate-500 leading-relaxed">
            Only authorized repository administrators can gain access. Logging
            in will link your GitHub account's developer permissions.
          </p>

          <a href="/admin/auth/login-redirect" class="block w-full">
            <Button
              className="w-full h-12 bg-gradient-to-r from-purple-600 to-cyan-600 hover:from-purple-500 hover:to-cyan-500 text-white font-semibold rounded-xl border-none shadow-lg shadow-purple-600/35 transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-3"
            >
              <svg class="h-5 w-5 fill-white" viewBox="0 0 24 24">
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                />
              </svg>
              Sign In with GitHub
            </Button>
          </a>

          <div
            class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-800/80"
          >
            <span>Power of Astro SSR</span>
            <span>Octokit REST Engine</span>
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>
