{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "To install dependencies and run",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hvidom/maybesoft.git"
	},
	"keywords": [],
	"author": "hvidom",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hvidom/maybesoft/issues"
	},
	"homepage": "https://github.com/hvidom/maybesoft#readme",
	"scripts": {
		"start": "bun run generate-types && bun run astro check && bun run astro dev --verbose",
		"dev": "astro dev",
		"browserslist": "bunx update-browserslist-db@latest",
		"build": "bun run astro build && bun run build:tailwind && bun run build:postcss",
		"sync": "astro sync",
		"build:tailwind": "bun x @tailwindcss/cli -i src/styles/global.css -o dist/global.css --minify",
		"build:postcss": "postcss dist/global.css -o dist/global.css",
		"preview": "bunx --bun astro build && bun run build:tailwind && bun run build:postcss && astro preview",
		"astro": "astro",
		"db:push": "bun drizzle-kit push",
		"db:seed": "bun src/db/seed.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bunx drizzle-kit migrate",
		"studio": "bunx drizzle-kit studio --port 4984",
		"db:check": "bun drizzle-kit check",
		"generate-types": "wrangler types",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^13.5.4",
		"@astrojs/mdx": "^5.0.6",
		"@astrojs/react": "^5.0.5",
		"@astrojs/sitemap": "^3.7.2",
		"@fontsource-variable/inter": "^5.2.8",
		"@libsql/client": "^0.17.3",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@tailwindcss/cli": "^4.3.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"astro": "^6.3.7",
		"baseline-browser-mapping": "^2.10.32",
		"better-auth": "^1.6.11",
		"bun-plugin-tailwind": "^0.1.2",
		"caniuse-lite": "^1.0.30001793",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"gray-matter": "^4.0.3",
		"hono": "^4.12.22",
		"lucide-react": "^1.16.0",
		"marked": "^18.0.4",
		"octokit": "^5.0.5",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.8.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.94.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@cloudflare/workers-types": "^4.20260524.1",
		"@types/bun": "latest",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.15",
		"postcss-cli": "^11.0.1",
		"tailwindcss": "^4.3.0"
	},
	"overrides": {
		"vite": "^7"
	}
}
